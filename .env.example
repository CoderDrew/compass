# Copy to .env.local for local development (never commit .env.local).
# Both values are in Supabase: Project Settings → API (or "Connect").
# The anon/publishable key is designed to be public; your data is protected by row-level security.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
